{
  "name": "diploma",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "npm run build",
    "start": "node server.js",
    "build": "npm run build:client",
    "build:client": "cd client && npm install && npm run build",
    "dev:backend": "nodemon server.js",
    "dev:frontend": "cd client && npm run dev",
    "dev": "npm run build:client && npm run dev:backend",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles --forceExit",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^2.4.5",
    "serve": "^14.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.7",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  }
}
